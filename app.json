{
  "expo": {
    "name": "EduMoney",
    "slug": "edumoney",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edumoney.app",
      "infoPlist": {
        "RCTAsyncStorageExcludeFromBackup": true,
        "CFBundleLocalizations": [
          "es"
        ],
        "CFBundleDevelopmentRegion": "es"
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.edumoney.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/withLocalOnly.cjs",
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecciona un comprobante para revisarlo y decidir si conservar una copia local cifrada.",
          "cameraPermission": "Toma una foto del comprobante para reconocer su texto en este dispositivo.",
          "microphonePermission": "Dicta datos para revisarlos antes de guardar. No conservamos grabaciones de audio."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Dicta datos para revisarlos antes de guardar. No conservamos grabaciones de audio.",
          "speechRecognitionPermission": "Usa reconocimiento de voz en el dispositivo cuando est\u00e9 disponible.",
          "androidSpeechServicePackages": [
            "com.google.android.as"
          ]
        }
      ],
      "expo-asset"
    ],
    "updates": {
      "enabled": false
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "scheme": "edumoney",
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "es"
    }
  }
}
